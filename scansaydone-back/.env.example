# Copia este archivo a .env y completa los valores. Nunca subas .env al repositorio.
# Las variables POSTGRES_* las crea la integración de Supabase en Vercel.
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
# Opcional: si existe, tiene prioridad sobre POSTGRES_URL.
DATABASE_URL=
# Opcional: orígenes permitidos por CORS, separados por comas.
ALLOWED_ORIGINS=
# Opcional: expresión regular de orígenes permitidos (vistas previas de Vercel).
ALLOWED_ORIGIN_REGEX=
